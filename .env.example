# ──────────────────────────────────────────────
# Konecty — runtime credentials (skill testing)
# Obtained via the konecty-session skill (OTP login)
# ──────────────────────────────────────────────
KONECTY_URL=https://<your-instance>.konecty.com
KONECTY_TOKEN=<authId from konecty-session>

# ──────────────────────────────────────────────
# Security audits
# ──────────────────────────────────────────────

# Snyk Agent Scan — required for `uvx snyk-agent-scan@latest --skills`
# Get your token at https://app.snyk.io/account
SNYK_TOKEN=

# ──────────────────────────────────────────────
# Marketplace publishing
# Most CLIs use interactive login — no token needed here.
# Run once per machine:
#   gh auth login          → GitHub CLI (gh skill publish)
#   clawhub login          → OpenClaw
#   socket login           → Socket security CLI
# ──────────────────────────────────────────────
