# Copy to e2e/.env and adjust as needed. All have sane defaults in docker-compose.yml.

# Konecty image tag (newer tags expose the admin-meta + query API surface).
KONECTY_IMAGE_TAG=3.8.10

# Alternate host ports so the e2e stack coexists with a dev Konecty on :3000.
E2E_KONECTY_PORT=3100
E2E_MONGO_PORT=27117

# Namespace / database name for the disposable instance.
E2E_NAMESPACE=e2e

# RabbitMQ credentials (local only).
RABBITMQ_USER=admin
RABBITMQ_PASS=admin
