#!/usr/bin/env bash
set -euo pipefail

MANIFEST="skills/konecty-data/shared-files.txt"
DATA_DIR="skills/konecty-data"
META_DIR="skills/konecty-meta"

# If konecty-meta doesn't exist, skip (not an error — only one skill installed)
if [ ! -d "$META_DIR" ]; then
  exit 0
fi

# If the manifest doesn't exist, nothing to check
if [ ! -f "$MANIFEST" ]; then
  exit 0
fi

failed=0

while IFS= read -r rel_path || [ -n "$rel_path" ]; do
  # Skip empty lines
  [ -z "$rel_path" ] && continue

  data_file="$DATA_DIR/$rel_path"
  meta_file="$META_DIR/$rel_path"

  # Both files must exist
  if [ ! -f "$data_file" ]; then
    echo "ERROR: shared file missing in konecty-data: $rel_path" >&2
    failed=1
    continue
  fi
  if [ ! -f "$meta_file" ]; then
    echo "ERROR: shared file missing in konecty-meta: $rel_path" >&2
    failed=1
    continue
  fi

  # Compare SHA256 checksums
  if command -v sha256sum &>/dev/null; then
    hash_data=$(sha256sum "$data_file" | awk '{print $1}')
    hash_meta=$(sha256sum "$meta_file" | awk '{print $1}')
  else
    # macOS fallback
    hash_data=$(shasum -a 256 "$data_file" | awk '{print $1}')
    hash_meta=$(shasum -a 256 "$meta_file" | awk '{print $1}')
  fi

  if [ "$hash_data" != "$hash_meta" ]; then
    echo "ERROR: shared file diverged between konecty-data and konecty-meta: $rel_path" >&2
    echo "  konecty-data: $hash_data" >&2
    echo "  konecty-meta: $hash_meta" >&2
    failed=1
  fi

done < "$MANIFEST"

if [ "$failed" -ne 0 ]; then
  echo "" >&2
  echo "Commit blocked: shared files are not identical between konecty-data and konecty-meta." >&2
  echo "Update the diverging files so they are byte-identical in both skills, then retry." >&2
  exit 1
fi

exit 0
